pipeline {
    agent any

    stages {

        stage('Build & Test') {
            steps {
                dir('Restaurant-Reservation-Ordering-System') {
                    sh './mvnw clean test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Restaurant-Reservation-Ordering-System') {
                    withSonarQubeEnv('SonarQube') {
                        withCredentials([
                            string(
                                credentialsId: 'sonarqube-token',
                                variable: 'SONAR_AUTH_TOKEN'
                            )
                        ]) {
                            sh './mvnw verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=restaurant-reservation-ordering-system -Dsonar.token=$SONAR_AUTH_TOKEN'
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Restaurant-Reservation-Ordering-System') {
                    sh 'docker build -t restaurant-reservation:${BUILD_NUMBER} .'
                }
            }
        }
        stage('Trivy Scan') {
            steps {
                sh 'trivy image --severity HIGH,CRITICAL --scanners vuln restaurant-reservation:${BUILD_NUMBER}'
            }
        }
        stage('Push Image') {
            steps {
                sh 'docker tag restaurant-reservation:${BUILD_NUMBER} localhost:5000/restaurant-reservation:${BUILD_NUMBER}'
                sh 'docker push localhost:5000/restaurant-reservation:${BUILD_NUMBER}'
            }
        }

        stage('Update Image Tag') {
            steps {
                dir('Restaurant-Reservation-Ordering-System') {
                    sh '''
                        sed -i "s/tag: \\".*\\"/tag: \\"${BUILD_NUMBER}\\"/" restaurant-reservation/values.yaml
                        echo "Updated Helm image tag to ${BUILD_NUMBER}"
                        grep -A 3 "^image:" restaurant-reservation/values.yaml
                    '''
                }
            }
        }
        stage('Commit & Push Changes') {
            steps {
                dir('Restaurant-Reservation-Ordering-System') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-credentials',
                            usernameVariable: 'GIT_USERNAME',
                            passwordVariable: 'GIT_PASSWORD'
                        )
                    ]) {
                        sh '''
                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            git add restaurant-reservation/values.yaml
                            git commit -m "Update image tag to ${BUILD_NUMBER}" || echo "No changes to commit"

                            git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/shilo0h/RestaurantReservation-OrderSystem.git HEAD:master
                        '''
                    }
                }
            }
        }
    }
}